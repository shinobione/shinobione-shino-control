{
  "name": "shino-control",
  "version": "0.9.7",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/generate-brand-assets.mjs && node scripts/generate-build-info.mjs",
    "prestart": "npm run assets",
    "start": "node server-entry.mjs",
    "predev": "npm run assets",
    "dev": "node --watch server-entry.mjs",
    "check": "node scripts-check.mjs && node scripts-status-check.mjs && node scripts-derivation-cache-check.mjs && node scripts-github-cursor-check.mjs && node scripts-chatgpt-delta-check.mjs",
    "pages:snapshot": "node scripts/generate-pages-snapshot.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "repair": "node scripts/repair-state.mjs",
    "chat:audit": "node scripts/chatgpt-state-hygiene.mjs",
    "chat:repair": "node scripts/chatgpt-state-hygiene.mjs --apply"
  },
  "engines": { "node": ">=20" }
}
