{
  "manifest_version": 3,
  "name": "SHINO Sync",
  "version": "0.5.5",
  "description": "ChatGPT sync component for SHINO // CONTROL. Auto-syncs new threads in known projects, backfills full project/thread history, excludes sidebar contamination, and retries failed captures only.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "inventory.js",
        "thread-inventory.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SHINO Sync"
  }
}
