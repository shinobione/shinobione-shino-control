{
  "manifest_version": 3,
  "name": "SHINO Sync",
  "version": "0.6.1",
  "description": "ChatGPT sync component for SHINO // CONTROL. Main-project anchor inventory, stable project-ID normalization, retry provenance, rate-limit-safe sync, collision guards, and branded icons.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/shino-sync-16.png",
    "32": "icons/shino-sync-32.png",
    "48": "icons/shino-sync-48.png",
    "128": "icons/shino-sync-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js",
        "inventory.js",
        "thread-inventory.js",
        "rate-limit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SHINO Sync",
    "default_icon": {
      "16": "icons/shino-sync-16.png",
      "32": "icons/shino-sync-32.png",
      "48": "icons/shino-sync-48.png",
      "128": "icons/shino-sync-128.png"
    }
  }
}
