{
  "manifest_version": 3,
  "name": "SHINO // CONTROL Collector",
  "version": "0.1.0",
  "description": "Minimal ChatGPT delta sensor for SHINO // CONTROL. No inventory, popup, mapping or backfill logic.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
